# ZombieCoder Ollama Optimization Settings
# Memory Management
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1
OLLAMA_AUTO_CLEAN_MEMORY=true
OLLAMA_LAZY_LOAD=true
OLLAMA_MEMORY_LIMIT=2GB

# Performance Settings
OLLAMA_KEEP_ALIVE=5m
OLLAMA_TIMEOUT=120s
OLLAMA_MAX_QUEUE=10

# Cache Settings
OLLAMA_CACHE_ENABLED=true
OLLAMA_CACHE_SIZE=1GB
OLLAMA_CACHE_TTL=3600s

# Model Settings
OLLAMA_DEFAULT_MODEL=gemma:2b
OLLAMA_FALLBACK_MODEL=deepseek-coder:1.3b

# Logging
OLLAMA_LOG_LEVEL=INFO
OLLAMA_LOG_FILE=logs/ollama.log
